{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traelyx.dev/schemas/local-commentary-manifest-v1.json",
  "title": "Release-reviewed local narrator data artifact (no production entries yet)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "sha256",
    "bytes",
    "format",
    "runtime",
    "runtimeVersion",
    "minAndroidApi",
    "abis",
    "license",
    "source",
    "evidence",
    "contractVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "format": {
      "enum": [
        "gguf",
        "litertlm"
      ]
    },
    "runtime": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "minAndroidApi": {
      "type": "integer",
      "minimum": 26,
      "maximum": 100
    },
    "abis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "arm64-v8a",
          "x86_64",
          "armeabi-v7a",
          "x86"
        ]
      }
    },
    "license": {
      "type": "string",
      "maxLength": 300,
      "format": "uri",
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "source": {
      "type": "string",
      "maxLength": 300,
      "format": "uri",
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "evidence": {
      "type": "string",
      "pattern": "^docs/reference/[a-z0-9][a-z0-9_-]{0,99}\\.json$"
    },
    "contractVersion": {
      "const": 1,
      "type": "integer"
    }
  }
}
